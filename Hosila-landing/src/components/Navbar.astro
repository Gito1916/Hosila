---
import Button from './Button.astro';
const pathname = Astro.url.pathname;
---
<header class="sticky top-0 z-50 w-full bg-surface-base/90 backdrop-blur-md border-b border-border-subtle">
  <div class="container-custom mx-auto h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 transition-transform hover:scale-105">
      <img src="/logo.svg" alt="Hosila Logo" class="h-8 w-8" />
      <span class="font-bold text-2xl text-textColor-heading tracking-tight">Hosila</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-8">
      <a href="/" class={`text-sm font-medium transition-colors ${pathname === '/' ? 'text-brand-600' : 'text-textColor-body hover:text-brand-600 focus:text-brand-600 outline-none'}`}>Home</a>
      <a href="/pricing" class={`text-sm font-medium transition-colors ${pathname.startsWith('/pricing') ? 'text-brand-600' : 'text-textColor-body hover:text-brand-600 focus:text-brand-600 outline-none'}`}>Pricing</a>
      <a href="/blog" class={`text-sm font-medium transition-colors ${pathname.startsWith('/blog') ? 'text-brand-600' : 'text-textColor-body hover:text-brand-600 focus:text-brand-600 outline-none'}`}>Blog</a>
      <a href="/contact" class={`text-sm font-medium transition-colors ${pathname.startsWith('/contact') ? 'text-brand-600' : 'text-textColor-body hover:text-brand-600 focus:text-brand-600 outline-none'}`}>Contact Us</a>
    </nav>

    <!-- Actions -->
    <div class="hidden lg:flex items-center gap-4">
      <Button variant="ghost" href="https://app.hosila.com/login">Log in</Button>
      <Button variant="primary" href="https://app.hosila.com">Get Started</Button>
    </div>

    <!-- Mobile Menu Toggle -->
    <button id="mobile-menu-toggle" class="lg:hidden p-2 text-textColor-heading hover:text-brand-600 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" x2="20" y1="12" y2="12"></line>
        <line x1="4" x2="20" y1="6" y2="6"></line>
        <line x1="4" x2="20" y1="18" y2="18"></line>
      </svg>
    </button>
  </div>
  </div>

  <!-- Mobile Menu Panel -->
  <div id="mobile-menu" class="hidden absolute top-20 left-0 w-full bg-surface-base border-b border-border-subtle p-6 flex-col gap-4 shadow-xl">
    <nav class="flex flex-col gap-4">
      <a href="/" class="text-textColor-body font-medium">Home</a>
      <a href="/pricing" class="text-textColor-body font-medium">Pricing</a>
      <a href="/blog" class="text-textColor-body font-medium">Blog</a>
      <a href="/contact" class="text-textColor-body font-medium">Contact Us</a>
    </nav>
    <div class="flex flex-col gap-4 pt-4 mt-2 border-t border-border-subtle">
      <Button variant="ghost" href="https://app.hosila.com/login" class="w-full justify-center">Log in</Button>
      <Button variant="primary" href="https://app.hosila.com" class="w-full justify-center">Get Started</Button>
    </div>
  </div>
</header>
<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      menu.classList.toggle('flex');
    });
  }
</script>
