---
---
<footer class="bg-brand-100 pt-16 pb-8 border-t border-brand-200">
  <div class="container-custom mx-auto">
    <!-- Top Row -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-8 mb-12">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 transition-transform hover:scale-105">
        <img src="/logo.svg" alt="Hosila Logo" class="h-8 w-8" />
        <span class="font-bold text-2xl text-textColor-heading tracking-tight">Hosila</span>
      </a>

      <!-- Navigation Links -->
      <nav class="flex flex-wrap items-center justify-center gap-6">
        <a href="/" class="text-sm font-medium text-textColor-body hover:text-brand-600 transition-colors">Home</a>
        <a href="/pricing" class="text-sm font-medium text-textColor-body hover:text-brand-600 transition-colors">Pricing</a>
        <a href="/blog" class="text-sm font-medium text-textColor-body hover:text-brand-600 transition-colors">Blog</a>
        <a href="/contact" class="text-sm font-medium text-textColor-body hover:text-brand-600 transition-colors">Contact Us</a>
      </nav>

      <!-- Social Icons -->
      <div class="flex items-center gap-4 text-textColor-heading">
        <a href="https://facebook.com/hosila" target="_blank" rel="noopener noreferrer" class="hover:text-brand-600 transition-colors" aria-label="Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
        <a href="https://www.instagram.com/hosila.app?igsh=MTgzbHA3Mzl3Mzltag==" target="_blank" rel="noopener noreferrer" class="hover:text-brand-600 transition-colors" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
        <a href="https://x.com/Hosilateam" target="_blank" rel="noopener noreferrer" class="hover:text-brand-600 transition-colors" aria-label="Twitter">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
        </a>
        <a href="https://linkedin.com/company/hosila" target="_blank" rel="noopener noreferrer" class="hover:text-brand-600 transition-colors" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
      </div>
    </div>

    <!-- Divider -->
    <div class="h-px w-full bg-border-strong mb-8"></div>

    <!-- Bottom Row -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-sm text-textColor-muted">
        &copy; {new Date().getFullYear()} Hosila. All rights reserved.
      </p>
      
      <div class="flex items-center gap-6">
        <a href="/privacy" class="text-sm text-textColor-muted hover:text-brand-600 transition-colors">Privacy Policy</a>
        <a href="/terms" class="text-sm text-textColor-muted hover:text-brand-600 transition-colors">Terms of Service</a>
        <a href="/cookies" class="text-sm text-textColor-muted hover:text-brand-600 transition-colors">Cookie Settings</a>
      </div>
    </div>
  </div>
</footer>
