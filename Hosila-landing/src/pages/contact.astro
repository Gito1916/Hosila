---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact Us | Hosila Hotel Software">
  <Navbar />
  
  <main class="flex-grow w-full bg-surface-base">
    <!-- Header Section -->
    <section class="py-20 lg:py-24 bg-brand-50 border-b border-border-subtle">
      <div class="container-custom text-center max-w-3xl mx-auto">
        <h1>
          We're here to help you run better
        </h1>
        <p>
          Have questions about Hosila? Ready to see a demo? Drop us a line and our hospitality experts will get right back to you.
        </p>
      </div>
    </section>

    <!-- Main Content -->
    <section class="py-24 min-h-[600px]">
      <div class="container-custom grid lg:grid-cols-2 gap-16">
        
        <!-- Contact Info -->
        <div class="space-y-12">
          <div>
            <h2>Get in touch</h2>
            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div class="p-3 bg-brand-100 text-brand-600 rounded-xl mt-1">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <div>
                  <h3>Email Support</h3>
                  <a href="mailto:hosilateam@gmail.com" class="text-textColor-body hover:text-brand-500 transition-colors">hosilateam@gmail.com</a>
                </div>
              </div>
              
              <div class="flex items-start gap-4">
                <div class="p-3 bg-brand-100 text-brand-600 rounded-xl mt-1">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </div>
                <div>
                  <h3>Sales & Enquiries</h3>
                  <a href="tel:+2349063814659" class="text-textColor-body hover:text-brand-500 transition-colors">+2349063814659</a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="bg-surface-card p-8 lg:p-12 rounded-3xl border border-border-strong shadow-xl">
          <h2>Send us a message</h2>

          <!-- Success message (hidden by default) -->
          <div id="form-success" class="hidden p-6 rounded-2xl bg-brand-50 border border-brand-200 text-center space-y-2">
            <div class="text-4xl">✅</div>
            <p class="text-lg font-semibold text-textColor-heading">Message sent!</p>
            <p class="text-sm text-textColor-muted">We typically reply within 2 hours during business days.</p>
          </div>

          <form id="contact-form" class="space-y-6">
            <!-- Honeypot (hidden from real users) -->
            <div class="absolute -left-[9999px]" aria-hidden="true">
              <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <input type="hidden" id="started_at" name="started_at" />

            <div class="grid md:grid-cols-2 gap-6">
              <div class="space-y-2">
                <label for="name" class="block text-sm font-bold text-textColor-heading">Full Name *</label>
                <input type="text" id="name" name="name" required minlength="2" maxlength="100" placeholder="Your full name" class="w-full px-4 py-3 rounded-xl border border-border-strong focus:outline-none focus:ring-2 focus:ring-brand-500 bg-surface-base" />
              </div>
              <div class="space-y-2">
                <label for="email" class="block text-sm font-bold text-textColor-heading">Email *</label>
                <input type="email" id="email" name="email" required placeholder="you@email.com" class="w-full px-4 py-3 rounded-xl border border-border-strong focus:outline-none focus:ring-2 focus:ring-brand-500 bg-surface-base" />
              </div>
            </div>

            <div class="space-y-2">
              <label for="phone" class="block text-sm font-bold text-textColor-heading">Phone Number *</label>
              <input type="tel" id="phone" name="phone" required minlength="7" maxlength="30" placeholder="+234 900 000 0000" class="w-full px-4 py-3 rounded-xl border border-border-strong focus:outline-none focus:ring-2 focus:ring-brand-500 bg-surface-base" />
            </div>

            <div class="space-y-2">
              <label for="message" class="block text-sm font-bold text-textColor-heading">Message *</label>
              <textarea id="message" name="message" rows="5" required minlength="12" maxlength="3000" placeholder="Tell us how we can help — demo request, pricing question, or anything else..." class="w-full px-4 py-3 rounded-xl border border-border-strong focus:outline-none focus:ring-2 focus:ring-brand-500 bg-surface-base resize-none"></textarea>
            </div>

            <!-- Error message -->
            <div id="form-error" class="hidden p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm"></div>

            <button type="submit" id="submit-btn" class="w-full py-4 text-lg font-semibold rounded-xl bg-brand-500 text-white hover:bg-brand-600 active:bg-brand-700 transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
              Send Message
            </button>
            <p class="text-center text-sm text-textColor-muted">We typically reply within 2 hours during business days.</p>
          </form>
        </div>

      </div>
    </section>

  </main>
  
  <Footer />
</Layout>

<script>
  // Set started_at timestamp on page load for bot detection
  const startedAtInput = document.getElementById('started_at') as HTMLInputElement;
  if (startedAtInput) {
    startedAtInput.value = String(Math.floor(Date.now() / 1000));
  }

  const API_URL = 'https://api.hosila.com/api/v1/email/contact';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const errorDiv = document.getElementById('form-error') as HTMLDivElement;
  const successDiv = document.getElementById('form-success') as HTMLDivElement;

  function showError(msg: string) {
    errorDiv.textContent = msg;
    errorDiv.classList.remove('hidden');
  }

  function hideError() {
    errorDiv.classList.add('hidden');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();

    // Disable button and show loading state
    submitBtn.disabled = true;
    const originalText = submitBtn.textContent;
    submitBtn.textContent = 'Sending...';

    const payload = {
      name: (document.getElementById('name') as HTMLInputElement).value.trim(),
      email: (document.getElementById('email') as HTMLInputElement).value.trim(),
      phone: (document.getElementById('phone') as HTMLInputElement).value.trim(),
      message: (document.getElementById('message') as HTMLTextAreaElement).value.trim(),
      website: (document.getElementById('website') as HTMLInputElement).value,
      started_at: parseInt(startedAtInput.value, 10) || null,
    };

    try {
      const res = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        // Success — hide form, show success message
        form.classList.add('hidden');
        successDiv.classList.remove('hidden');
        return;
      }

      // Handle specific error codes
      const data = await res.json().catch(() => ({}));
      const detail = data.detail || '';

      if (res.status === 429) {
        showError('Too many submissions. Please try again in a few minutes.');
      } else if (res.status === 400 || res.status === 422) {
        showError(detail || 'Please check your input and try again.');
      } else if (res.status === 502) {
        showError('Unable to deliver your message right now. Please try again shortly.');
      } else {
        showError('Something went wrong. Please try again or email us directly.');
      }
    } catch (err) {
      showError('Network error. Please check your connection and try again.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });
</script>
