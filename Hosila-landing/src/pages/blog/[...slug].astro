---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`${entry.data.title} | Hosila Blog`} description={entry.data.summary} image={entry.data.image}>
  <Navbar />
  
  <main class="flex-grow w-full bg-surface-base pb-24">
    <!-- Post Header -->
    <div class="container-custom max-w-4xl mx-auto pt-8 pb-4">
      <a href="/blog" class="inline-flex items-center gap-2 text-textColor-muted hover:text-brand-600 transition-colors text-sm font-medium">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to Blog
      </a>
    </div>
    <header class="py-8 lg:py-16 bg-surface-inset border-b border-border-subtle">
      <div class="container-custom max-w-4xl mx-auto text-center">
        <span class="text-sm text-textColor-muted font-medium tracking-wide uppercase block mb-4">
          {new Date(entry.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </span>
        <h1>{entry.data.title}</h1>
        <div class="flex items-center justify-center gap-4">
          <div class="w-12 h-12 bg-white text-brand-600 rounded-full flex items-center justify-center font-bold shadow-sm">
             {entry.data.author.charAt(0)}
          </div>
          <div class="text-left">
            <span class="block font-bold text-textColor-heading">{entry.data.author}</span>
            <span class="text-sm text-textColor-muted">Hosila Contributing Writer</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Post Image -->
    {entry.data.image && (
    <div class="container-custom max-w-5xl mx-auto -mt-10 relative z-10 mb-16">
      <img src={entry.data.image} alt={entry.data.title} class="w-full h-auto max-h-[600px] object-cover rounded-3xl shadow-xl" />
    </div>
    )}

    <!-- Content -->
    <article class="container-custom max-w-3xl mx-auto prose prose-lg prose-headings:text-textColor-heading prose-a:text-brand-500 hover:prose-a:text-brand-600 prose-img:rounded-xl">
      <Content />
    </article>

    <!-- Testimonial -->
    <section class="container-custom max-w-4xl mx-auto mt-24 px-8 py-12 bg-brand-50 rounded-3xl border border-brand-100 text-center">
      <div class="text-brand-500 flex justify-center mb-6">
        <svg fill="currentColor" width="48" height="48" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
      </div>
      <p class="italic">&quot;Hosila transformed everything. Their content is spot on, and their software is even better. We grew our revenue by 20% by plugging the leaks in our POS and inventory.&quot;</p>
      <span class="block font-bold text-textColor-heading">David O.</span>
      <span class="text-sm text-textColor-muted">Boutique Hotel Manager</span>
    </section>

    <!-- CTA -->
    <section class="container-custom max-w-4xl mx-auto mt-16 text-center">
      <h2>Ready to see it in action?</h2>
      <Button variant="primary" href="/contact" class="text-lg px-8 py-4">Explore Hosila Today</Button>
    </section>

  </main>
  
  <Footer />
</Layout>
